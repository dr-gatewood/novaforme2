<UserControl x:Class="Nova4Me2.App.Views.FirmwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Text="Firmware" Style="{StaticResource H1}" />
      <TextBlock Text="What is installed, what is known for this model, and where the vendor's updater lives. Nova4Me2 never flashes firmware itself." Style="{StaticResource Muted}" Margin="0,0,0,14" />
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock x:Name="ModelText" FontSize="18" FontWeight="SemiBold" />
          <TextBlock x:Name="FamilyText" Style="{StaticResource Muted}" />
          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Installed firmware" Style="{StaticResource Muted}" FontSize="12" />
              <TextBlock x:Name="InstalledText" FontSize="22" FontWeight="Light" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Latest known (reference table)" Style="{StaticResource Muted}" FontSize="12" />
              <TextBlock x:Name="LatestText" FontSize="22" FontWeight="Light" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Status" Style="{StaticResource Muted}" FontSize="12" />
              <TextBlock x:Name="StatusText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
          <TextBlock x:Name="KnownText" Style="{StaticResource Muted}" Margin="0,10,0,0" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Known issues for this model" Style="{StaticResource H2}" Margin="0,0,0,6" />
          <TextBlock x:Name="IssuesText" Style="{StaticResource Body}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="NVMe firmware capabilities" Style="{StaticResource H2}" Margin="0,0,0,6" />
          <TextBlock x:Name="NvmeText" Style="{StaticResource Body}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="How to update" Style="{StaticResource H2}" Margin="0,0,0,6" />
          <TextBlock Style="{StaticResource Body}" Text="1. Copy your data off first (Browse / Clone). 2. Attach the SSD natively (M.2 / SATA), not through a USB enclosure; vendor tools cannot talk to the drive through most bridges. 3. Run the vendor tool; it verifies the model and installs only signed images. 4. Never interrupt power during the update." />
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="ToolButton" Content="Open vendor tool page" Style="{StaticResource AccentButton}" Click="Tool_Click" />
            <Button x:Name="SupportButton" Content="Vendor support" Click="Support_Click" />
          </StackPanel>
          <TextBlock x:Name="ToolNote" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
