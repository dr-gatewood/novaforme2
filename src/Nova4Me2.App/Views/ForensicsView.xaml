<UserControl x:Class="Nova4Me2.App.Views.ForensicsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="Analysis / Forensics" Style="{StaticResource H1}" />
        <TextBlock Text="Alternate data streams, signature carving, steganography and Sleuth-Kit style volume tools. Everything extracted lands in the project folder." Style="{StaticResource Muted}" />
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Style="{StaticResource CardAlt}" Padding="12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Project" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" />
        <TextBox x:Name="ProjectName" Grid.Column="1" ToolTip="Name of the folder that receives extracted files" />
        <Button x:Name="StartProject" Grid.Column="2" Content="Start / switch" Click="StartProject_Click" Margin="8,0,8,0" />
        <TextBlock x:Name="ProjectPath" Grid.Column="3" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="4" Orientation="Horizontal">
          <ComboBox x:Name="ProjectList" Width="180" SelectionChanged="ProjectList_SelectionChanged" ToolTip="Existing projects" />
          <Button Content="Open folder" Click="OpenProject_Click" Margin="8,0,0,0" />
        </StackPanel>
      </Grid>
    </Border>
    <TabControl Grid.Row="2" x:Name="Tabs">
      <!-- ADS -->
      <TabItem Header="Alternate data streams">
        <Grid Margin="0,8,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="AdsScanButton" Content="Scan volume" Style="{StaticResource AccentButton}" Click="AdsScan_Click" />
            <Button Content="Extract selected" Click="AdsExtractSelected_Click" />
            <Button Content="Extract all" Click="AdsExtractAll_Click" />
            <TextBlock x:Name="AdsStatus" Style="{StaticResource Muted}" VerticalAlignment="Center" />
          </StackPanel>
          <ListView x:Name="AdsList" Grid.Row="1" SelectionMode="Extended" Margin="0,8,0,0">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="File" Width="380" DisplayMemberBinding="{Binding File.Path}" />
                <GridViewColumn Header="Stream" Width="160" DisplayMemberBinding="{Binding StreamName}" />
                <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding SizeText}" />
                <GridViewColumn Header="Classification" Width="220" DisplayMemberBinding="{Binding Kind}" />
                <GridViewColumn Header="Content" Width="200" DisplayMemberBinding="{Binding Content}" />
                <GridViewColumn Header="Extracted to" Width="300" DisplayMemberBinding="{Binding ExtractedPath}" />
              </GridView>
            </ListView.View>
          </ListView>
          <TextBlock Grid.Row="2" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" Text="Zone.Identifier streams record where a download came from; anything else attached to a file is worth a look. Extraction writes each stream as its own file (path__stream.ext)." />
        </Grid>
      </TabItem>
      <!-- Carving -->
      <TabItem Header="File carving">
        <Grid Margin="0,8,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Style="{StaticResource CardAlt}" Padding="12">
            <StackPanel>
              <WrapPanel>
                <TextBlock Text="Scope:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <RadioButton x:Name="ScopeUnalloc" Style="{StaticResource Pill}" Content="Unallocated space (deleted files)" IsChecked="True" />
                <RadioButton x:Name="ScopeVolume" Style="{StaticResource Pill}" Content="Whole volume" />
                <RadioButton x:Name="ScopeDisk" Style="{StaticResource Pill}" Content="Whole disk" />
                <RadioButton x:Name="ScopeFile" Style="{StaticResource Pill}" Content="Inside one file" />
                <TextBox x:Name="CarveFilePath" Width="300" Margin="6,0,4,0" ToolTip="Path on the volume (e.g. Users\Alice\photo.jpg) or a local file picked with Browse…" />
                <Button Content="Browse local…" Click="CarveBrowse_Click" />
              </WrapPanel>
              <WrapPanel x:Name="TypePanel" Margin="0,8,0,0" />
              <WrapPanel Margin="0,4,0,0">
                <CheckBox x:Name="CarveNested" Content="Report files embedded inside other carved files" />
                <Button x:Name="CarveStart" Content="Start carving" Style="{StaticResource AccentButton}" Click="CarveStart_Click" />
                <Button x:Name="CarveStop" Content="Stop" Click="CarveStop_Click" IsEnabled="False" />
                <Button Content="Extract selected" Click="CarveExtractSelected_Click" />
                <Button Content="Extract all" Click="CarveExtractAll_Click" />
                <Button Content="Hex preview" Click="CarvePreview_Click" />
              </WrapPanel>
              <ProgressBar x:Name="CarveProgress" Maximum="100" Margin="0,8,0,4" />
              <TextBlock x:Name="CarveStatus" Style="{StaticResource Muted}" />
            </StackPanel>
          </Border>
          <ListView x:Name="CarveList" Grid.Row="2" SelectionMode="Extended">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Offset" Width="130" DisplayMemberBinding="{Binding OffsetText}" />
                <GridViewColumn Header="Type" Width="300" DisplayMemberBinding="{Binding TypeName}" />
                <GridViewColumn Header="Size" Width="100" DisplayMemberBinding="{Binding SizeText}" />
                <GridViewColumn Header="Confidence" Width="150" DisplayMemberBinding="{Binding Confidence}" />
                <GridViewColumn Header="Notes" Width="120" DisplayMemberBinding="{Binding Notes}" />
                <GridViewColumn Header="Extracted to" Width="360" DisplayMemberBinding="{Binding ExtractedPath}" />
              </GridView>
            </ListView.View>
          </ListView>
        </Grid>
      </TabItem>
      <!-- Stego -->
      <TabItem Header="Embedded data &amp; steganography">
        <Grid Margin="0,8,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <WrapPanel>
            <TextBox x:Name="StegoPath" Width="420" ToolTip="Path on the volume (e.g. Users\Alice\photo.jpg) or a local file" />
            <Button Content="Browse local…" Click="StegoBrowse_Click" />
            <Button x:Name="StegoRun" Content="Analyze" Style="{StaticResource AccentButton}" Click="Stego_Click" />
            <Button Content="Extract selected" Click="StegoExtractSelected_Click" />
            <Button Content="Extract all payloads" Click="StegoExtractAll_Click" />
            <Button Content="Export LSB plane" Click="StegoLsb_Click" ToolTip="Write the least-significant bits of every pixel (BMP/PNG) to a file for further analysis" />
          </WrapPanel>
          <Border Grid.Row="1" Style="{StaticResource CardAlt}" Margin="0,8,0,8" Padding="12">
            <StackPanel>
              <TextBlock x:Name="StegoSummary" Style="{StaticResource Body}" Text="Pick a file and press Analyze." />
              <TextBlock x:Name="StegoLsbText" Style="{StaticResource Muted}" />
            </StackPanel>
          </Border>
          <ListView x:Name="StegoList" Grid.Row="2" SelectionMode="Extended">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Severity" Width="90" DisplayMemberBinding="{Binding SeverityText}" />
                <GridViewColumn Header="Finding" Width="320" DisplayMemberBinding="{Binding Title}" />
                <GridViewColumn Header="Detail" Width="560" DisplayMemberBinding="{Binding Detail}" />
                <GridViewColumn Header="Extractable" Width="90" DisplayMemberBinding="{Binding ExtractableText}" />
              </GridView>
            </ListView.View>
          </ListView>
        </Grid>
      </TabItem>
      <!-- Bad sectors -->
      <TabItem Header="Bad sectors">
        <Grid Margin="0,8,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="190" />
          </Grid.RowDefinitions>
          <WrapPanel>
            <TextBox x:Name="BadLogPath" Width="520" ToolTip="The .badsectors.txt the imager wrote next to an image, a GNU ddrescue mapfile, or a plain list of LBAs" />
            <Button Content="Browse…" Click="BadBrowse_Click" />
            <Button x:Name="BadRun" Content="Analyze" Style="{StaticResource AccentButton}" Click="BadAnalyze_Click" />
            <Button x:Name="BadStop" Content="Stop" Click="BadStop_Click" IsEnabled="False" />
            <Button Content="Save report (TXT + CSV)" Click="BadSave_Click" />
            <TextBlock x:Name="BadStatus" Style="{StaticResource Muted}" VerticalAlignment="Center" />
          </WrapPanel>
          <Border x:Name="BadProgressCard" Grid.Row="1" Style="{StaticResource CardAlt}" Margin="0,8,0,0" Padding="12" Visibility="Collapsed">
            <StackPanel>
              <Grid>
                <TextBlock x:Name="BadPhase" Text="Starting…" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,70,0" />
                <TextBlock x:Name="BadPercent" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Top" />
              </Grid>
              <ProgressBar x:Name="BadBar" Maximum="100" Margin="0,10,0,4" IsIndeterminate="True" />
              <TextBlock x:Name="BadElapsed" Style="{StaticResource Muted}" />
            </StackPanel>
          </Border>
          <Border Grid.Row="2" Style="{StaticResource CardAlt}" Margin="0,8,0,8" Padding="12">
            <StackPanel>
              <TextBlock x:Name="BadHeadline" Style="{StaticResource Body}" FontWeight="SemiBold" TextWrapping="Wrap" Text="Pick the bad-sector log of an image and press Analyze to see which files (if any) the unreadable sectors belong to." />
              <TextBlock x:Name="BadVerdict" Style="{StaticResource Muted}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <ListView x:Name="BadList" Grid.Row="3" SelectionMode="Extended">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Where" Width="400" DisplayMemberBinding="{Binding Where}" />
                <GridViewColumn Header="Kind" Width="160" DisplayMemberBinding="{Binding Kind}" />
                <GridViewColumn Header="Lost" Width="90" DisplayMemberBinding="{Binding Lost}" />
                <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding Size}" />
                <GridViewColumn Header="Offsets in file" Width="230" DisplayMemberBinding="{Binding Range}" />
                <GridViewColumn Header="Hits" Width="60" DisplayMemberBinding="{Binding Hits}" />
                <GridViewColumn Header="Impact" Width="640" DisplayMemberBinding="{Binding Impact}" />
              </GridView>
            </ListView.View>
          </ListView>
          <TextBox x:Name="BadDetail" Grid.Row="4" Margin="0,8,0,0" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AcceptsReturn="True" TextWrapping="NoWrap" VerticalContentAlignment="Top" />
        </Grid>
      </TabItem>
      <!-- Sleuth Kit -->
      <TabItem Header="Sleuth Kit tools">
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
            <StackPanel>
              <Border Style="{StaticResource CardAlt}" Padding="10">
                <StackPanel>
                  <TextBlock Text="Volume" FontWeight="SemiBold" />
                  <WrapPanel Margin="0,6,0,0">
                    <Button Content="fsstat" Click="FsStat_Click" ToolTip="File system statistics" />
                    <Button Content="blkls → unallocated.bin" Click="Blkls_Click" ToolTip="Write all unallocated clusters to a file (with a range map)" />
                    <Button Content="Build cluster map" Click="BuildOwners_Click" ToolTip="Index which file owns which cluster (needed for blkstat owner lookup)" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardAlt}" Padding="10">
                <StackPanel>
                  <TextBlock Text="MFT record (istat / icat)" FontWeight="SemiBold" />
                  <WrapPanel Margin="0,6,0,0">
                    <TextBox x:Name="RecordBox" Width="90" ToolTip="MFT entry number" />
                    <TextBox x:Name="StreamBox" Width="110" Margin="6,0,0,0" ToolTip="stream name (empty = main data)" />
                    <Button Content="istat" Click="IStat_Click" Margin="6,0,6,0" />
                    <Button Content="icat → file" Click="ICat_Click" />
                    <Button Content="ffind" Click="FFind_Click" ToolTip="Full path of the record" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardAlt}" Padding="10">
                <StackPanel>
                  <TextBlock Text="Cluster (blkstat / blkcat)" FontWeight="SemiBold" />
                  <WrapPanel Margin="0,6,0,0">
                    <TextBox x:Name="ClusterBox" Width="120" ToolTip="Logical cluster number" />
                    <Button Content="blkstat" Click="BlkStat_Click" Margin="6,0,6,0" />
                    <Button Content="blkcat (hex)" Click="BlkCat_Click" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardAlt}" Padding="10">
                <StackPanel>
                  <TextBlock Text="Listing &amp; timeline (fls / mactime)" FontWeight="SemiBold" />
                  <WrapPanel Margin="0,6,0,0">
                    <CheckBox x:Name="FlsDeleted" Content="include deleted (MFT scan)" />
                    <Button Content="fls → CSV" Click="FlsCsv_Click" />
                    <Button Content="fls → body file" Click="FlsBody_Click" />
                    <Button Content="timeline → CSV" Click="Timeline_Click" />
                    <Button Content="ils (deleted entries)" Click="Ils_Click" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardAlt}" Padding="10">
                <StackPanel>
                  <TextBlock Text="Slack space &amp; change journal" FontWeight="SemiBold" />
                  <WrapPanel Margin="0,6,0,0">
                    <Button Content="Scan file slack" Click="Slack_Click" />
                    <Button Content="Extract all slack" Click="SlackExtract_Click" />
                    <Button Content="USN journal" Click="Usn_Click" ToolTip="Recent create/change/delete events from $UsnJrnl" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <TextBlock x:Name="TskStatus" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </ScrollViewer>
          <TextBox x:Name="TskOutput" Grid.Column="1" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AcceptsReturn="True" TextWrapping="NoWrap" VerticalContentAlignment="Top" />
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
