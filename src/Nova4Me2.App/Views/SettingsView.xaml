<UserControl x:Class="Nova4Me2.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock Text="Settings" Style="{StaticResource H1}" />
      <TextBlock Text="Changes apply immediately and are remembered." Style="{StaticResource Muted}" Margin="0,0,0,14" />
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Theme" Style="{StaticResource H2}" Margin="0,0,0,8" />
          <WrapPanel x:Name="ThemePanel" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Drive connection" Style="{StaticResource H2}" Margin="0,0,0,8" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="260" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="Reconnect time-out (seconds)" VerticalAlignment="Center" Grid.Row="0" />
            <TextBox x:Name="ReconnectBox" Grid.Row="0" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="0,3" LostFocus="Save" />
            <TextBlock Text="Read chunk size (KiB)" VerticalAlignment="Center" Grid.Row="1" />
            <TextBox x:Name="ChunkBox" Grid.Row="1" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="0,3" LostFocus="Save" />
            <TextBlock Text="Throttle (MB/s, 0 = unlimited)" VerticalAlignment="Center" Grid.Row="2" />
            <TextBox x:Name="ThrottleBox" Grid.Row="2" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="0,3" LostFocus="Save" />
            <TextBlock Text="Keepalive reads" VerticalAlignment="Center" Grid.Row="3" />
            <CheckBox x:Name="KeepaliveBox" Grid.Row="3" Grid.Column="1" Content="Read one sector every few seconds so the enclosure never idles" Checked="Save" Unchecked="Save" />
          </Grid>
          <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" Text="Connection settings take effect the next time a drive is opened." />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Copy defaults" Style="{StaticResource H2}" Margin="0,0,0,8" />
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="260" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Default destination folder" VerticalAlignment="Center" />
            <TextBox x:Name="DestBox" Grid.Column="1" LostFocus="Save" Margin="0,0,8,0" />
            <Button Grid.Column="2" Content="Browse…" Click="BrowseDest_Click" Margin="0" />
          </Grid>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="260" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="When a file already exists" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <RadioButton x:Name="ColSkip" Style="{StaticResource Pill}" Content="Skip" Checked="Save" />
              <RadioButton x:Name="ColOverwrite" Style="{StaticResource Pill}" Content="Overwrite" Checked="Save" />
              <RadioButton x:Name="ColRename" Style="{StaticResource Pill}" Content="Rename new copy" Checked="Save" />
            </StackPanel>
          </Grid>
          <WrapPanel>
            <CheckBox x:Name="VerifyBox" Content="Verify each file after copying" Checked="Save" Unchecked="Save" />
            <CheckBox x:Name="ZeroFillBox" Content="Zero-fill unreadable sectors inside files (partial recovery)" Checked="Save" Unchecked="Save" />
            <CheckBox x:Name="AdsBox" Content="Copy alternate data streams" Checked="Save" Unchecked="Save" />
            <CheckBox x:Name="TimesBox" Content="Preserve timestamps" Checked="Save" Unchecked="Save" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="About" Style="{StaticResource H2}" Margin="0,0,0,6" />
          <TextBlock x:Name="AboutText" Style="{StaticResource Muted}" />
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Open log folder" Click="OpenLog_Click" />
            <Button Content="Reset settings" Click="Reset_Click" Margin="0" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
