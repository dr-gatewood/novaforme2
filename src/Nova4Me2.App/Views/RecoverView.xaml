<UserControl x:Class="Nova4Me2.App.Views.RecoverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Nova4Me2.App.Views">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,14">
      <StackPanel>
        <TextBlock Text="Recover" Style="{StaticResource H1}" />
        <TextBlock Text="Copy jobs run one at a time. Files with unreadable sectors are written with zero-filled gaps and listed in the report." Style="{StaticResource Muted}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button Content="Clear finished" Click="Clear_Click" Margin="0" />
      </StackPanel>
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock x:Name="EmptyText" Text="No jobs yet. Select files in Browse and press Copy to… (or drag them into Explorer)." Style="{StaticResource Muted}" />
        <ItemsControl x:Name="JobList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <Grid>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                      <TextBlock Text="{Binding Destination}" Style="{StaticResource Muted}" FontSize="12" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                      <Button Content="Cancel" Click="Cancel_Click" Visibility="{Binding IsActive, Converter={x:Static local:BoolToVis.Instance}}" />
                      <Button Content="Open folder" Click="Open_Click" />
                      <Button Content="Save report…" Click="Report_Click" Visibility="{Binding IsFinished, Converter={x:Static local:BoolToVis.Instance}}" Margin="0" />
                    </StackPanel>
                  </Grid>
                  <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Margin="0,12,0,8" />
                  <TextBlock Text="{Binding StatusText}" FontSize="12" />
                  <TextBlock Text="{Binding CurrentFile}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                  <Expander Header="{Binding ErrorCount}" HeaderStringFormat="Problems ({0})" Margin="0,6,0,0" Foreground="{DynamicResource TextMuted}" Visibility="{Binding ErrorCount, Converter={x:Static local:CountToVis.Instance}}">
                    <ItemsControl ItemsSource="{Binding Progress.Errors}" MaxHeight="220">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Warn}">
                            <Run Text="{Binding Path, Mode=OneWay}" /><Run Text=" — " /><Run Text="{Binding Message, Mode=OneWay}" />
                          </TextBlock>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Expander>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
