<UserControl x:Class="Nova4Me2.App.Views.WindowsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="Windows tools" Style="{StaticResource H1}" />
        <TextBlock Text="What Windows itself sees — the Get-PhysicalDisk / Get-Disk / Get-Volume / diskpart view — and the actions those tools offer. Every button shows the exact command it runs; nothing here writes to disk sectors." Style="{StaticResource Muted}" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click" />
        <Button Content="Rescan disks" Click="Rescan_Click" ToolTip="diskpart rescan + Update-HostStorageCache" />
        <Button Content="Report…" Click="Report_Click" ToolTip="Save everything on this page as TXT / HTML / PDF" />
      </StackPanel>
    </Grid>
    <Border x:Name="BusyCard" Grid.Row="1" Style="{StaticResource CardAlt}" Padding="12" Margin="0,0,0,10" Visibility="Collapsed">
      <StackPanel>
        <Grid>
          <TextBlock x:Name="BusyPhase" Text="Asking Windows…" FontWeight="SemiBold" />
          <TextBlock x:Name="BusyElapsed" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
        </Grid>
        <ProgressBar x:Name="BusyBar" Maximum="100" IsIndeterminate="True" Margin="0,8,0,0" />
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <!-- summary strip -->
        <Border Style="{StaticResource Card}">
          <WrapPanel x:Name="SummaryStrip" ItemHeight="26">
            <TextBlock x:Name="OsText" Style="{StaticResource Body}" Margin="0,0,18,0" VerticalAlignment="Center" Text="Windows" />
            <Border CornerRadius="999" Padding="10,2" Background="{DynamicResource PanelAlt}" Margin="0,0,8,0" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="Automount_Click" ToolTip="Click to toggle (mountvol /E or /N)">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="AutomountDot" Width="8" Height="8" Margin="0,0,6,0" Fill="{DynamicResource TextMuted}" />
                <TextBlock x:Name="AutomountText" FontSize="12" Text="automount" />
              </StackPanel>
            </Border>
            <Border CornerRadius="999" Padding="10,2" Background="{DynamicResource PanelAlt}" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="diskpart san policy">
              <TextBlock x:Name="SanText" FontSize="12" Text="SAN policy" />
            </Border>
            <ItemsControl x:Name="ServicePills" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="999" Padding="10,2" Background="{DynamicResource PanelAlt}" Margin="0,0,8,0" ToolTip="{Binding Tip}" Cursor="Hand" MouseLeftButtonUp="Service_Click" Tag="{Binding}">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{Binding Dot}" />
                      <TextBlock Text="{Binding Text}" FontSize="12" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Restart storage services" Click="RestartServices_Click" Style="{StaticResource GhostButton}" ToolTip="Restart-Service vds, StorSvc -Force — fixes 'The RPC server is unavailable' in Disk Management" />
          </WrapPanel>
        </Border>

        <!-- findings -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="What Windows is not doing" Style="{StaticResource H2}" Margin="0,0,0,6" />
            <ItemsControl x:Name="FindingList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border}" Padding="0,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Ellipse Width="8" Height="8" Fill="{Binding Dot}" VerticalAlignment="Top" Margin="0,6,0,0" />
                      <StackPanel Grid.Column="1" Margin="4,0,12,0">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Command}" Style="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Accent}" Margin="0,3,0,0" TextWrapping="Wrap" Visibility="{Binding CommandVisibility}" />
                      </StackPanel>
                      <Button Grid.Column="2" Content="{Binding ActionLabel}" Tag="{Binding}" Click="FindingAction_Click" VerticalAlignment="Center" Margin="0" Visibility="{Binding ActionVisibility}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- disks -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Grid>
              <TextBlock Text="Disks" Style="{StaticResource H2}" Margin="0" />
              <WrapPanel x:Name="DiskActions" HorizontalAlignment="Right" IsEnabled="False">
                <Button Content="Bring online" Click="DiskOnline_Click" ToolTip="Set-Disk -IsOffline $false" />
                <Button Content="Take offline" Click="DiskOffline_Click" ToolTip="Set-Disk -IsOffline $true" />
                <Button Content="Clear read-only" Click="DiskClearRo_Click" ToolTip="Set-Disk -IsReadOnly $false" />
                <Button Content="Import foreign" Click="DiskImport_Click" ToolTip="diskpart: select disk N / import" />
                <Button Content="Re-detect device" Click="DiskRedetect_Click" ToolTip="pnputil /remove-device, then /scan-devices — rebuilds the disk object" Margin="0" />
              </WrapPanel>
            </Grid>
            <TextBlock Text="Physical disks as Get-PhysicalDisk reports them, joined with Get-Disk and diskpart. Select a row to act on it." Style="{StaticResource Muted}" FontSize="12" />
            <ListView x:Name="DiskList" Margin="0,8,0,0" SelectionMode="Single" SelectionChanged="DiskList_SelectionChanged" MaxHeight="220">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="#" Width="40" DisplayMemberBinding="{Binding Number}" />
                  <GridViewColumn Header="Model" Width="240" DisplayMemberBinding="{Binding Model}" />
                  <GridViewColumn Header="Windows status" Width="230" DisplayMemberBinding="{Binding Status}" />
                  <GridViewColumn Header="Style" Width="70" DisplayMemberBinding="{Binding Style}" />
                  <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding Size}" />
                  <GridViewColumn Header="Bus" Width="70" DisplayMemberBinding="{Binding Bus}" />
                  <GridViewColumn Header="Media" Width="70" DisplayMemberBinding="{Binding Media}" />
                  <GridViewColumn Header="Health" Width="90" DisplayMemberBinding="{Binding Health}" />
                  <GridViewColumn Header="Firmware" Width="90" DisplayMemberBinding="{Binding Firmware}" />
                  <GridViewColumn Header="Serial" Width="190" DisplayMemberBinding="{Binding Serial}" />
                  <GridViewColumn Header="Device Manager" Width="220" DisplayMemberBinding="{Binding Pnp}" />
                </GridView>
              </ListView.View>
            </ListView>
          </StackPanel>
        </Border>

        <!-- volumes -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Grid>
              <TextBlock Text="Volumes" Style="{StaticResource H2}" Margin="0" />
              <WrapPanel x:Name="VolumeActions" HorizontalAlignment="Right" IsEnabled="False">
                <ComboBox x:Name="LetterBox" Width="64" ToolTip="Letter to assign" />
                <Button Content="Assign letter" Click="VolAssign_Click" ToolTip="diskpart: select volume N / assign letter=X" />
                <Button Content="Remove letter" Click="VolRemove_Click" ToolTip="diskpart: select volume N / remove" />
                <Button Content="chkdsk (read-only)" Click="VolChkdsk_Click" ToolTip="chkdsk X: without /f — reports problems, changes nothing" />
                <Button Content="Open in Explorer" Click="VolOpen_Click" Margin="0" />
              </WrapPanel>
            </Grid>
            <TextBlock Text="Get-Volume joined with diskpart list volume. RAW means Windows cannot read the file system; Nova4Me2's Browse view still can." Style="{StaticResource Muted}" FontSize="12" />
            <ListView x:Name="VolumeList" Margin="0,8,0,0" SelectionMode="Single" SelectionChanged="VolumeList_SelectionChanged" MaxHeight="220">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="Vol" Width="46" DisplayMemberBinding="{Binding Number}" />
                  <GridViewColumn Header="Letter" Width="60" DisplayMemberBinding="{Binding Letter}" />
                  <GridViewColumn Header="Label" Width="160" DisplayMemberBinding="{Binding Label}" />
                  <GridViewColumn Header="File system" Width="90" DisplayMemberBinding="{Binding Fs}" />
                  <GridViewColumn Header="Type" Width="90" DisplayMemberBinding="{Binding Type}" />
                  <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding Size}" />
                  <GridViewColumn Header="Free" Width="90" DisplayMemberBinding="{Binding Free}" />
                  <GridViewColumn Header="Health" Width="90" DisplayMemberBinding="{Binding Health}" />
                  <GridViewColumn Header="Disk" Width="50" DisplayMemberBinding="{Binding Disk}" />
                  <GridViewColumn Header="Info" Width="120" DisplayMemberBinding="{Binding Info}" />
                </GridView>
              </ListView.View>
            </ListView>
          </StackPanel>
        </Border>

        <!-- device manager -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Grid>
              <TextBlock Text="Device Manager — disk drives" Style="{StaticResource H2}" Margin="0" />
              <WrapPanel HorizontalAlignment="Right">
                <Button Content="Remove phantom entries" Click="Phantoms_Click" ToolTip="pnputil /remove-device for every disk marked CM_PROB_PHANTOM" />
                <Button Content="Scan for hardware changes" Click="PnpScan_Click" ToolTip="pnputil /scan-devices" Margin="0" />
              </WrapPanel>
            </Grid>
            <ListView x:Name="PnpList" Margin="0,8,0,0" MaxHeight="160">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="Device" Width="300" DisplayMemberBinding="{Binding Name}" />
                  <GridViewColumn Header="Status" Width="90" DisplayMemberBinding="{Binding Status}" />
                  <GridViewColumn Header="Problem" Width="170" DisplayMemberBinding="{Binding Problem}" />
                  <GridViewColumn Header="Instance id" Width="520" DisplayMemberBinding="{Binding InstanceId}" />
                </GridView>
              </ListView.View>
            </ListView>
          </StackPanel>
        </Border>

        <!-- events -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Grid>
              <TextBlock Text="Storage events" Style="{StaticResource H2}" Margin="0" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <RadioButton x:Name="Hours3" Style="{StaticResource Pill}" Content="3 h" Checked="Hours_Changed" />
                <RadioButton x:Name="Hours24" Style="{StaticResource Pill}" Content="24 h" IsChecked="True" Checked="Hours_Changed" />
                <RadioButton x:Name="Hours168" Style="{StaticResource Pill}" Content="7 days" Checked="Hours_Changed" />
              </StackPanel>
            </Grid>
            <TextBlock Text="System log: disk, partmgr, storahci/stornvme, volmgr, Ntfs, Kernel-PnP. Application log: Virtual Disk Service. IDs 7/11/51 = I/O errors, 129 = reset after timeout, 153/157 = retried or surprise-removed I/O." Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
            <ListView x:Name="EventList" Margin="0,8,0,0" MaxHeight="260">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="Time" Width="140" DisplayMemberBinding="{Binding Time}" />
                  <GridViewColumn Header="Source" Width="150" DisplayMemberBinding="{Binding Source}" />
                  <GridViewColumn Header="Id" Width="50" DisplayMemberBinding="{Binding Id}" />
                  <GridViewColumn Header="Level" Width="80" DisplayMemberBinding="{Binding Level}" />
                  <GridViewColumn Header="Message" Width="800" DisplayMemberBinding="{Binding Message}" />
                </GridView>
              </ListView.View>
            </ListView>
          </StackPanel>
        </Border>

        <!-- console -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Grid>
              <TextBlock Text="Console" Style="{StaticResource H2}" Margin="0" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Copy" Click="ConsoleCopy_Click" Style="{StaticResource GhostButton}" />
                <Button Content="Clear" Click="ConsoleClear_Click" Style="{StaticResource GhostButton}" Margin="0" />
              </StackPanel>
            </Grid>
            <TextBlock Text="Every command this page runs, with its output, so you can repeat it by hand in PowerShell or diskpart." Style="{StaticResource Muted}" FontSize="12" />
            <TextBox x:Name="Console" Margin="0,8,0,0" Height="200" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AcceptsReturn="True" TextWrapping="NoWrap" VerticalContentAlignment="Top" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
