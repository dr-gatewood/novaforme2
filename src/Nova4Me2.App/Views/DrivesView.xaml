<UserControl x:Class="Nova4Me2.App.Views.DrivesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,14">
      <StackPanel>
        <TextBlock Text="Drives" Style="{StaticResource H1}" />
        <TextBlock Text="Pick the disk to recover. Everything is read directly from the sectors, so a RAW volume is fine." Style="{StaticResource Muted}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button Content="Refresh" Click="Refresh_Click" />
        <Button Content="Open image file…" Click="OpenImage_Click" />
        <Button Content="Stabilize USB…" Click="Usb_Click" ToolTip="Stop Windows from suspending or re-probing the enclosure" />
      </StackPanel>
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock x:Name="EmptyText" Style="{StaticResource Muted}" Text="Scanning for drives…" Margin="0,0,0,10" />
        <ItemsControl x:Name="Cards">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}" Width="330" Margin="0,0,14,14" Cursor="Hand" MouseLeftButtonUp="Card_Click" BorderBrush="{Binding BorderBrush}">
                <StackPanel>
                  <Grid>
                    <TextBlock Text="{Binding Model}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,0,70,0" />
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="999" Padding="8,2" Background="{DynamicResource PanelAlt}">
                      <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                    </Border>
                  </Grid>
                  <TextBlock Text="{Binding SizeText}" FontSize="22" FontWeight="Light" Margin="0,6,0,2" />
                  <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" />
                  <TextBlock Text="{Binding VolumesText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" />
                  <TextBlock Text="{Binding Warning}" Foreground="{DynamicResource Warn}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Style="{StaticResource Card}" x:Name="VolumesCard" Visibility="Collapsed" Margin="0,8,0,0">
      <StackPanel>
        <Grid>
          <TextBlock x:Name="VolumesTitle" Text="NTFS volumes" Style="{StaticResource H2}" Margin="0" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Deep signature scan" Click="DeepScan_Click" ToolTip="Search the whole disk for NTFS boot sectors (slow)" />
            <Button Content="Browse files" Style="{StaticResource AccentButton}" Click="Browse_Click" Margin="0" />
          </StackPanel>
        </Grid>
        <ListBox x:Name="VolumeList" SelectionChanged="VolumeList_SelectionChanged" Margin="0,8,0,0" MaxHeight="140">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding Display}" />
                <TextBlock Text="{Binding NotesText}" Style="{StaticResource Muted}" FontSize="11" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="PartitionsText" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
