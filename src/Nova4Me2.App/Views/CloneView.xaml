<UserControl x:Class="Nova4Me2.App.Views.CloneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Nova4Me2.App.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Text="Clone / Image" Style="{StaticResource H1}" />
      <TextBlock Text="Bit-for-bit copies. The source is only ever read; hashes are computed on the way; unreadable sectors are logged and retried sector by sector." Style="{StaticResource Muted}" Margin="0,0,0,14" />
      <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,16,0">
            <TextBlock Text="What to copy" Style="{StaticResource H2}" Margin="0,0,0,6" />
            <RadioButton x:Name="ScopeDisk" Style="{StaticResource Pill}" Content="Whole disk" IsChecked="True" Checked="Scope_Changed" />
            <RadioButton x:Name="ScopePartition" Style="{StaticResource Pill}" Content="One partition" Checked="Scope_Changed" Margin="0,6,0,0" />
            <ComboBox x:Name="PartitionCombo" Margin="0,8,0,0" IsEnabled="False" />
            <TextBlock x:Name="SourceText" Style="{StaticResource Muted}" Margin="0,10,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Where to put it" Style="{StaticResource H2}" Margin="0,0,0,6" />
            <RadioButton x:Name="TargetFile" Style="{StaticResource Pill}" Content="Image file (.img)" IsChecked="True" Checked="Target_Changed" />
            <RadioButton x:Name="TargetDrive" Style="{StaticResource Pill}" Content="Another physical drive (forensic clone)" Checked="Target_Changed" Margin="0,6,0,0" />
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="FilePath" Grid.Column="0" Margin="0,0,8,0" />
              <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse…" Click="BrowseFile_Click" Margin="0" />
            </Grid>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="DriveCombo" Grid.Column="0" Margin="0,0,8,0" IsEnabled="False" />
              <Button x:Name="RefreshDrivesButton" Grid.Column="1" Content="Refresh" Click="RefreshDrives_Click" Margin="0" IsEnabled="False" />
            </Grid>
            <TextBlock x:Name="TargetWarning" Foreground="{DynamicResource Warn}" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Options" Style="{StaticResource H2}" Margin="0,0,0,6" />
          <WrapPanel>
            <CheckBox x:Name="TwoPass" Content="Two-pass (skip bad chunks first, retry sector by sector)" IsChecked="True" />
            <CheckBox x:Name="Hash" Content="SHA-256" IsChecked="True" />
            <CheckBox x:Name="Md5" Content="MD5" />
            <CheckBox x:Name="Verify" Content="Verify target after copy" />
            <CheckBox x:Name="Resume" Content="Resume previous run" />
          </WrapPanel>
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="StartButton" Content="Start" Style="{StaticResource AccentButton}" Click="Start_Click" />
            <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" IsEnabled="False" />
            <Button x:Name="ReportButton" Content="Save report…" Click="Report_Click" IsEnabled="False" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Grid>
            <TextBlock x:Name="PhaseText" Text="Idle" FontWeight="SemiBold" />
            <TextBlock x:Name="EtaText" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
          </Grid>
          <ProgressBar x:Name="Progress" Maximum="100" Margin="0,10,0,10" />
          <c:BlockMapControl x:Name="Map" Height="180" />
          <WrapPanel Margin="0,10,0,0">
            <TextBlock x:Name="StatBytes" Style="{StaticResource Muted}" Margin="0,0,18,0" />
            <TextBlock x:Name="StatRate" Style="{StaticResource Muted}" Margin="0,0,18,0" />
            <TextBlock x:Name="StatBad" Style="{StaticResource Muted}" Margin="0,0,18,0" />
            <TextBlock x:Name="StatHash" Style="{StaticResource Mono}" FontSize="11" />
          </WrapPanel>
          <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0" Text="Map: green readable · amber slow · red unreadable · orange skipped (pass 1) · blue current position" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
