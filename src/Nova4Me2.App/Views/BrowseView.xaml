<UserControl x:Class="Nova4Me2.App.Views.BrowseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="Browse files" Style="{StaticResource H1}" />
        <TextBlock x:Name="Subtitle" Text="Select files or folders, then Copy to… or drag them into Explorer." Style="{StaticResource Muted}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <RadioButton x:Name="ModeIndex" Style="{StaticResource Pill}" Content="Directory index" IsChecked="True" Checked="Mode_Changed" />
        <RadioButton x:Name="ModeMft" Style="{StaticResource Pill}" Content="Rebuild from MFT" Checked="Mode_Changed" Margin="0,0,14,0" />
        <CheckBox x:Name="ShowDeleted" Content="Deleted" Checked="Filter_Changed" Unchecked="Filter_Changed" ToolTip="List deleted files found by the MFT scan" />
        <CheckBox x:Name="ShowSystem" Content="System files" Checked="Filter_Changed" Unchecked="Filter_Changed" />
        <ComboBox x:Name="MountLetter" Width="84" Margin="6,0,4,0" ToolTip="Drive letter for the read-only mount, or 'Folder…' to mount inside a folder you pick" />
        <Button x:Name="MountButton" Content="Mount as drive" Click="Mount_Click" ToolTip="Expose the volume read-only as a Windows drive letter or folder (WinFsp), so Explorer and any program can open its files" />
        <Button Content="Copy to…" Style="{StaticResource AccentButton}" Click="CopyTo_Click" Margin="0" />
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="260" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="6,2" Margin="0,0,10,0">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel x:Name="Breadcrumb" Orientation="Horizontal" />
        </ScrollViewer>
      </Border>
      <TextBox x:Name="FilterBox" Grid.Column="1" TextChanged="Filter_TextChanged" ToolTip="Filter this folder (name contains…)" />
    </Grid>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" MinWidth="160" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource Card}" Padding="6" Margin="0">
        <TreeView x:Name="Tree" SelectedItemChanged="Tree_SelectedItemChanged" TreeViewItem.Expanded="Tree_Expanded" />
      </Border>
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="6" Margin="0">
        <ListView x:Name="List" SelectionMode="Extended" MouseDoubleClick="List_DoubleClick" PreviewMouseLeftButtonDown="List_PreviewMouseDown" MouseMove="List_MouseMove" KeyDown="List_KeyDown">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="Name" Width="360">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <Path Data="{Binding IconData}" Stroke="{Binding IconBrush}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" StrokeLineJoin="Round" />
                      <TextBlock Text="{Binding Name}" Foreground="{Binding NameBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="Size" Width="100" DisplayMemberBinding="{Binding SizeText}" />
              <GridViewColumn Header="Type" Width="110" DisplayMemberBinding="{Binding TypeText}" />
              <GridViewColumn Header="Modified" Width="140" DisplayMemberBinding="{Binding ModifiedText}" />
              <GridViewColumn Header="Attributes" Width="180" DisplayMemberBinding="{Binding AttrText}" />
            </GridView>
          </ListView.View>
          <ListView.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Copy to…" Click="CopyTo_Click" />
              <MenuItem Header="Copy to default destination" Click="CopyDefault_Click" />
              <MenuItem Header="Open folder" Click="OpenFolder_Click" />
              <MenuItem Header="Copy path" Click="CopyPath_Click" />
              <MenuItem Header="Properties" Click="Properties_Click" />
            </ContextMenu>
          </ListView.ContextMenu>
        </ListView>
      </Border>
    </Grid>
    <Grid Grid.Row="3" Margin="0,8,0,0">
      <TextBlock x:Name="StatusLine" Style="{StaticResource Muted}" FontSize="12" />
      <TextBlock x:Name="MountStatus" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right" />
    </Grid>
  </Grid>
</UserControl>
