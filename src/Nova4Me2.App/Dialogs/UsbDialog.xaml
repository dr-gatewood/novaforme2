<Window x:Class="Nova4Me2.App.Dialogs.UsbDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stabilize USB connection" Width="620" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontFamily="{StaticResource UiFont}" FontSize="13" ShowInTaskbar="False">
  <StackPanel Margin="24">
    <TextBlock Text="Stabilize the USB enclosure" Style="{StaticResource H1}" FontSize="18" />
    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,12" Text="Windows power management and automount are the usual reasons an NVMe enclosure keeps dropping off mid-copy. These settings are the standard fixes; all of them are recorded and can be reverted here. Re-plug the enclosure afterwards." />
    <Border Style="{StaticResource CardAlt}">
      <StackPanel x:Name="StatusPanel" />
    </Border>
    <TextBlock x:Name="LogText" Style="{StaticResource Mono}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,12" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Close" Click="Close_Click" IsCancel="True" />
      <Button Content="Revert" Click="Revert_Click" />
      <Button x:Name="ApplyButton" Content="Apply tweaks" Style="{StaticResource AccentButton}" Click="Apply_Click" Margin="0" />
    </StackPanel>
  </StackPanel>
</Window>
