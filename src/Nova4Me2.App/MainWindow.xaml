<Window x:Class="Nova4Me2.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Nova4Me2.App.Controls"
        Title="Nova4Me2 — Drive Recovery" Width="1280" Height="820" MinWidth="960" MinHeight="600"
        Background="{DynamicResource Bg}" FontFamily="{StaticResource UiFont}" FontSize="13" WindowStartupLocation="CenterScreen"
        Foreground="{DynamicResource Text}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="64" />
      <RowDefinition Height="*" />
      <RowDefinition Height="30" />
    </Grid.RowDefinitions>

    <!-- Title bar -->
    <Border Grid.Row="0" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="18,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <c:NovaLogo Grid.Column="0" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="28,0,0,0">
          <TextBlock x:Name="TitleSource" Text="No drive opened" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
          <TextBlock x:Name="TitleVolume" Text="Pick a drive or open an image file to begin" Style="{StaticResource Muted}" FontSize="12" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Border x:Name="LinkBadge" CornerRadius="999" Padding="10,4" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="LinkDot" Width="9" Height="9" Fill="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,7,0" />
              <TextBlock x:Name="LinkText" Text="No device" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <Button x:Name="HelpButton" Style="{StaticResource GhostButton}" ToolTip="Help (F1)" Click="HelpButton_Click" Padding="8">
            <Path Data="{Binding Source=help, Converter={x:Static c:IconConverter.Instance}}" Stroke="{DynamicResource Text}" StrokeThickness="1.7" Width="20" Height="20" Stretch="Uniform" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Body -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="176" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{DynamicResource NavBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
        <StackPanel x:Name="NavPanel" Margin="10,14" />
      </Border>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition x:Name="LogRow" Height="0" />
        </Grid.RowDefinitions>
        <Grid x:Name="ContentHost" Grid.Row="0" Margin="24,20,24,12" ClipToBounds="True" />
        <Border Grid.Row="1" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
          <ListBox x:Name="LogList" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="8,4" />
        </Border>
        <!-- Help flyout -->
        <Border x:Name="HelpFlyout" Grid.RowSpan="2" HorizontalAlignment="Right" Width="420" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0" Visibility="Collapsed" Padding="22,18">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,10">
              <TextBlock x:Name="HelpTitle" Text="Help" Style="{StaticResource H1}" FontSize="20" />
              <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Content="✕" Click="HelpClose_Click" Padding="8,2" FontSize="14" />
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="HelpBody" />
            </ScrollViewer>
          </Grid>
        </Border>
        <!-- Busy overlay -->
        <Border x:Name="BusyOverlay" Grid.RowSpan="2" Background="#80000000" Visibility="Collapsed">
          <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,22" MinWidth="360">
            <StackPanel>
              <ProgressBar IsIndeterminate="True" Height="6" Margin="0,0,0,14" />
              <TextBlock x:Name="BusyText" Text="Working…" Style="{StaticResource Body}" FontSize="14" />
              <TextBlock x:Name="BusyDetail" Style="{StaticResource Muted}" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
        </Border>
        <!-- Toast -->
        <Border x:Name="ToastBox" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" MaxWidth="460" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="12" Padding="16,12" Visibility="Collapsed">
          <StackPanel>
            <TextBlock x:Name="ToastTitle" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
            <TextBlock x:Name="ToastText" Style="{StaticResource Muted}" Margin="0,4,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="2" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="18,0">
      <Grid>
        <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" FontSize="12" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock x:Name="StatusStats" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,0,16,0" VerticalAlignment="Center" />
          <Button Style="{StaticResource GhostButton}" Content="Log" Padding="8,2" FontSize="12" Click="ToggleLog_Click" Margin="0" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
